{
  "name": "outline-sections",
  "type": "module",
  "displayName": "Outline Sections",
  "description": "Injects section markers into the VS Code Outline view",
  "version": "1.0.1",
  "publisher": "mantasu",
  "repository": {
    "type": "git",
    "url": "https://github.com/mantasu/outline-sections"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "compile": "tsc -p ./",
    "test": "vitest run --coverage",
    "package": "npm run compile && npx @vscode/vsce package",
    "release": "npm run compile && semantic-release"
  },
  "extensionDependencies": [],
  "devDependencies": {
    "@semantic-release/changelog": "*",
    "@semantic-release/commit-analyzer": "*",
    "@semantic-release/git": "*",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "*",
    "@semantic-release/release-notes-generator": "*",
    "semantic-release": "^23.0.0",
    "semantic-release-vsce": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*",
    "typescript": "*",
    "@types/node": "*",
    "@types/vscode": "*"
  }
}
