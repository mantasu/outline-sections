{
  "name": "outline-sections",
  "displayName": "Outline Sections",
  "description": "Injects comment-based section markers into the VS Code Outline view",
  "version": "1.2.0",
  "icon": "assets/icon.png",
  "publisher": "mantasu",
  "repository": {
    "type": "git",
    "url": "https://github.com/mantasu/outline-sections"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "outline",
    "outline view",
    "code outline",
    "document symbols",
    "symbols",
    "code navigation",
    "navigation",
    "code organization",
    "code structure",
    "sections",
    "comment sections",
    "comment banners",
    "region",
    "regions",
    "folding",
    "code folding",
    "outline sections",
    "editor productivity",
    "workspace productivity",
    "typescript",
    "javascript",
    "python",
    "rust",
    "c",
    "cpp",
    "c++",
    "lsp",
    "language server"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Outline Sections",
      "properties": {
        "outlineSections.regionStartRegex": {
          "type": "string",
          "default": "",
          "markdownDescription": "Additional regex to detect custom region start lines. See [README](https://github.com/mantasu/outline-sections#settings) for examples.",
          "scope": "resource"
        },
        "outlineSections.regionEndRegex": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional regex to detect custom region end lines. If empty, regions close on the next region/header/subheader start.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "vitest run --coverage",
    "package": "npm run compile && npx @vscode/vsce package",
    "release": "npm run compile && semantic-release"
  },
  "extensionDependencies": [],
  "devDependencies": {
    "@semantic-release/changelog": "*",
    "@semantic-release/commit-analyzer": "*",
    "@semantic-release/git": "*",
    "@semantic-release/github": "*",
    "@semantic-release/npm": "*",
    "@semantic-release/release-notes-generator": "*",
    "semantic-release": "*",
    "semantic-release-vsce": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*",
    "typescript": "*",
    "@types/node": "*",
    "@types/vscode": "*"
  },
  "overrides": {
    "undici": "5.28.4"
  }
}
